{
	"name": "teresapelinski",
	"version": "1.1.6",
	"description": "teresapelinski's personal website",
	"repository": "git@github.com:pelinski/teresapelinski.git",
	"author": "Teresa Pelinski <teresapelinski@gmail.com>",
	"license": "MIT",
	"private": true,
	"staticFiles": {
		"staticPath": "public/"
	},
	"engines": {
		"node": "22.x",
		"yarn": "1.x"
	},
	"browserslist": [
		">0.2%",
		"not dead",
		"not op_mini all"
	],
	"dependencies": {
		"cursor-effects": "^1.0.17",
		"ejs": "^3.1.7",
		"follow-redirects": "^1.14.7",
		"jsdom": "^16.5.0",
		"minimist": "^1.2.6",
		"nanoid": "^3.1.31",
		"node-forge": "^1.0.0",
		"postcss": "^7.0.36",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"react-html-parser": "^2.0.2",
		"react-router-dom": "^7.15.0",
		"serve": "^14.2.6",
		"terser": "^5.14.2",
		"typescript": "^6.0.3"
	},
	"scripts": {
		"parse-posts": "node src/scripts/parsePosts.mjs",
		"generate-rss": "node src/scripts/generateRss.js",
		"prebuild": "rm -rf dist/ && yarn run parse-posts && yarn run generate-rss",
		"dev": "vite",
		"build": "tsc -b && yarn prebuild && vite build",
		"test": "yarn build",
		"release": "./scripts/release.sh",
		"preview": "vite preview --host",
		"lint": "eslint .",
		"prep-images": "node scripts/convert-to-webp.js",
		"prepare": "husky"
	},
	"devDependencies": {
		"@types/domutils": "^2.1.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/react-html-parser": "^2.0.7",
		"@vitejs/plugin-react": "^6.0.1",
		"baseline-browser-mapping": "^2.10.0",
		"buffer": "^5.5.0||^6.0.0",
		"cfonts": "^2.10.0",
		"events": "^3.3.0",
		"gray-matter": "^4.0.3",
		"husky": "^9.1.7",
		"marked": "^16.3.0",
		"prettier": "^2.5.1",
		"process": "^0.11.10",
		"sass": "^1.99.0",
		"sass-migrator": "^2.4.2",
		"surge": "^0.27.4",
		"vite": "^8.0.10",
		"vite-plugin-node-polyfills": "^0.26.0"
	}
}
